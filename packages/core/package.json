{
	"name": "@mitsuki/monitor-sdk-core",
	"version": "1.0.0",
	"description": "",
	"main": "build/cjs/index.cjs",
	"module": "build/esm/index.js",
	"types": "build/types/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./build/types/index.d.ts",
				"default": "./build/esm/index.js"
			},
			"require": {
				"types": "./build/types/index.d.ts",
				"default": "./build/cjs/index.cjs"
			}
		}
	},
	"scripts": {
		"build:transpile": "tsup",
		"build:type": "tsc -p tsconfig.types.json",
		"build:watch:transpile": "tsup --watch",
		"build:watch:type": "tsc -p tsconfig.types.json --watch",
		"build": "pnpm run build:transpile & pnpm run build:type",
		"build:watch": "pnpm run build:watch:transpile & pnpm run build:watch:type"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "module"
}
